systems {
    @zdl("orders/model.zdl")
    Orders {
        service OrderService {
            commands: createOrder
        }
    }
}

flow CheckoutFlow {
    @actor(Customer)
    start CheckoutStarted {
    }

    when CheckoutStarted do createOrder {
        service Orders.OrderService
        emits OrderCreated
    }

    end {
        completed: OrderCreated
    }
}
